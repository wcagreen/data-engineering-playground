# Copy this file to .env to override defaults.
# Docker Compose auto-loads .env if present in the project root.

# ─── Local host binding (safe default) ───────────────────────────────────────
# Keep this at 127.0.0.1 for local-only access.
# Change to 0.0.0.0 only if you intentionally need network access.
HOST_BIND=127.0.0.1

# ─── Airflow ──────────────────────────────────────────────────────────────────
AIRFLOW_UID=50000

# Single-compose version selector (defaults to Airflow 3.x)
# For Airflow 2.x set:
#   AIRFLOW_STACK_VARIANT=v2
#   AIRFLOW_DOCKERFILE=Dockerfile.v2
#   AIRFLOW_WEBSERVER_COMMAND=webserver
#   AIRFLOW_WEBSERVER_HEALTHCHECK_URL=http://localhost:8080/health
#   AIRFLOW_WORKER_COMMAND=celery worker --celery-hostname worker@%h
AIRFLOW_STACK_VARIANT=v3
AIRFLOW_DOCKERFILE=Dockerfile
AIRFLOW_WEBSERVER_COMMAND=api-server
AIRFLOW_WEBSERVER_HEALTHCHECK_URL=http://localhost:8080/api/v2/monitor/health
AIRFLOW_INTERNAL_API_SECRET_KEY=airflow-playground-internal-api-secret
AIRFLOW_EXECUTION_API_SECRET_KEY=airflow-playground-execution-api-secret
AIRFLOW_API_AUTH_JWT_SECRET=airflow-playground-api-auth-secret
AIRFLOW_WORKER_COMMAND=celery worker --celery-hostname worker@%h --pid /tmp/celery-worker.pid

# Airflow 2.x FAB admin user (used by airflow-init in both compose files).
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# ─── PostgreSQL (internal Airflow metadata DB) ───────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=airflow

# ─── Playground database (your data) ─────────────────────────────────────────
PLAYGROUND_DB=playground
PLAYGROUND_USER=playground_user
PLAYGROUND_PASSWORD=playground_pass

# Optional local dbt overrides (defaults are usually fine)
PLAYGROUND_HOST=postgres
PLAYGROUND_PORT=5432
PLAYGROUND_SCHEMA=production

# ─── pgAdmin ──────────────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Airflow 3.0 SimpleAuthManager password is read from scripts/airflow/passwords.json
# Example file content: {"admin": "admin"}
