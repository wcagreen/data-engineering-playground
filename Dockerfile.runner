# ─────────────────────────────────────────────────────────────────────────────
# python-runner — lightweight container that executes named Python scripts on
# demand via a simple HTTP API, mirroring the ECS / Lambda invoke pattern.
#
# The scripts/python/ directory is mounted at runtime as /scripts/ so any
# script you drop there is immediately available without rebuilding.
# ─────────────────────────────────────────────────────────────────────────────

FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
	flask==3.1.0 \
	pandas==2.3.3 \
	SQLAlchemy==2.0.49 \
	psycopg2-binary==2.9.10

# Bundle scripts for DockerOperator-launched ephemeral containers.
COPY scripts/python /scripts

# Keep source data path consistent with Airflow DAG configuration.
COPY data/raw /opt/airflow/data/raw

EXPOSE 8000

# runner.py is available in /scripts from the image build context.
CMD ["python", "/scripts/runner.py"]
