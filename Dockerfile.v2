FROM apache/airflow:2.11.2

USER root

# Install system dependencies needed to compile psycopg2 and dbt
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        python3-dev \
        libpq-dev \
        git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

USER airflow

COPY requirements.v2.txt /requirements.v2.txt

# Step 1 – Airflow-ecosystem packages pinned via the official constraints file.
# Avoids ResolutionTooDeep / ResolutionImpossible from the large Airflow graph.
ARG AIRFLOW_VERSION=2.11.2
ARG PYTHON_VERSION=3.12
RUN pip install --no-cache-dir \
    --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-${AIRFLOW_VERSION}/constraints-${PYTHON_VERSION}.txt" \
    -r /requirements.v2.txt

# Step 2 – Non-Airflow packages (dbt, soda) installed separately so their
# transitive deps don't conflict with Airflow's pinned packages.
RUN pip install --no-cache-dir \
    "dbt-core>=1.8.0,<2.0.0" \
    "dbt-postgres>=1.8.0,<2.0.0" \
    "soda-core-postgres>=3.3.0"
