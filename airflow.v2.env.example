# Airflow 2.x preset for docker-compose.yml
# Usage:
#   docker compose --env-file airflow.v2.env up --build -d

HOST_BIND=127.0.0.1
AIRFLOW_STACK_VARIANT=v2
AIRFLOW_DOCKERFILE=Dockerfile.v2
AIRFLOW_WEBSERVER_COMMAND=webserver
AIRFLOW_WEBSERVER_HEALTHCHECK_URL=http://localhost:8080/health
AIRFLOW_WORKER_COMMAND=celery worker --celery-hostname worker@%h
# Absolute host path to this repo's data directory for DockerOperator bind mounts.
# Windows Docker Desktop example: path/to/data
HOST_DATA_DIR=path/to/data
HOST_SCRIPTS_DIR=path/to/data

# Airflow admin login (FAB auth in v2)
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=changeme

# ── Credentials ───────────────────────────────────────────────────────────────────────────────────────────────────
# Copy this file to airflow.v2.env and fill in your own values.
# PostgreSQL — Airflow metadata DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=airflow

# PostgreSQL — Playground data DB
PLAYGROUND_DB=playground
PLAYGROUND_USER=playground_user
PLAYGROUND_PASSWORD=changeme
