# Airflow 3.x preset for docker-compose.yml (matches defaults)
# Usage:
#   docker compose --env-file airflow.v3.env up --build -d

HOST_BIND=127.0.0.1
AIRFLOW_STACK_VARIANT=v3
AIRFLOW_DOCKERFILE=Dockerfile
AIRFLOW_WEBSERVER_COMMAND=api-server
AIRFLOW_WEBSERVER_HEALTHCHECK_URL=http://localhost:8080/api/v2/monitor/health
AIRFLOW_EXECUTION_API_SERVER_URL=http://airflow-webserver:8080/execution/
AIRFLOW_INTERNAL_API_SECRET_KEY=airflow-playground-internal-api-secret
AIRFLOW_EXECUTION_API_SECRET_KEY=airflow-playground-execution-api-secret
AIRFLOW_API_AUTH_JWT_SECRET=airflow-playground-api-auth-secret
AIRFLOW_WORKER_COMMAND=celery worker --celery-hostname worker@%h --pid /tmp/celery-worker.pid
